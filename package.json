{
  "name": "@abdullah-altun/react-animation-library",
  "version": "0.1.0",
  "description": "Modern React animation library with CSS-based state management, interactive micro-animations, and advanced orchestration",
  "homepage": "https://github.com/abdullahaltun70/react-animation-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullahaltun70/react-animation-library.git"
  },
  "bugs": {
    "url": "https://github.com/abdullahaltun70/react-animation-library/issues"
  },
  "author": "Abdullah Altun",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && [ -f dist/index.d.mts ] && mv dist/index.d.mts dist/index.d.ts || true",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn build",
    "size": "ls -lah dist/ && echo 'Total package size:' && du -sh dist/"
  },
  "keywords": [
    "react",
    "typescript",
    "animation",
    "scss",
    "css",
    "nextjs",
    "components",
    "ui",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "sass": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.23",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "sass": "^1.89.0",
    "tsup": "^8.2.3",
    "typescript": "^5"
  },
  "license": "MIT",
  "dependencies": {}
}
